  {
   "scene": "hook",
   "i": 0,
   "k": 0,
   "text": "這是中山大學資管系的阿哲",
   "start": 2.4,
   "end": 5.56,
   "syll": 12
  },
  {
   "scene": "hook",
   "i": 1,
   "k": 1,
   "text": "每天五點下課鐘一響　他就衝去 YouBike 站",
   "start": 5.88,
   "end": 10.09,
   "syll": 16
  },
  {
   "scene": "hook",
   "i": 2,
   "k": 2,
   "text": "可是常常一台車都沒有",
   "start": 10.41,
   "end": 13.04,
   "syll": 10
  },
  {
   "scene": "data",
   "i": 3,
   "k": 0,
   "text": "我們從十月開始　每十分鐘記錄一次　中山大學五公里內的 309 個站",
   "start": 18.04,
   "end": 25.93,
   "syll": 30
  },
  {
   "scene": "data",
   "i": 4,
   "k": 1,
   "text": "上課日傍晚五點到八點　校內的站有四成時間是空的",
   "start": 26.25,
   "end": 32.04,
   "syll": 22
  },
  {
   "scene": "data",
   "i": 5,
   "k": 2,
   "text": "五點半到六點半　超過一半",
   "start": 32.36,
   "end": 35.26,
   "syll": 11
  },
  {
   "scene": "data",
   "i": 6,
   "k": 3,
   "text": "早上剛好反過來　車停滿了　還不了",
   "start": 35.58,
   "end": 39.26,
   "syll": 14
  },
  {
   "scene": "app",
   "i": 7,
   "k": 0,
   "text": "更麻煩的是　這時校內大部分的站同時沒車",
   "start": 40.66,
   "end": 45.4,
   "syll": 18
  },
  {
   "scene": "app",
   "i": 8,
   "k": 1,
   "text": "App 只能叫你走遠一點去借",
   "start": 45.72,
   "end": 48.61,
   "syll": 11
  },
  {
   "scene": "app",
   "i": 9,
   "k": 2,
   "text": "車　必須在下課前就回到校內",
   "start": 48.93,
   "end": 52.09,
   "syll": 12
  },
  {
   "scene": "timing",
   "i": 10,
   "k": 0,
   "text": "車有回來　只是回得太早",
   "start": 53.49,
   "end": 56.12,
   "syll": 10
  },
  {
   "scene": "timing",
   "i": 11,
   "k": 1,
   "text": "下午兩點到晚上八點還到校內的車　將近七成在五點前就到了",
   "start": 56.44,
   "end": 63.29,
   "syll": 26
  },
  {
   "scene": "timing",
   "i": 12,
   "k": 2,
   "text": "可是官方的友愛接力　要等站空了才送五元",
   "start": 63.61,
   "end": 68.34,
   "syll": 18
  },
  {
   "scene": "timing",
   "i": 13,
   "k": 3,
   "text": "所以這些車　只有 3% 拿到獎勵",
   "start": 68.66,
   "end": 72.61,
   "syll": 15
  },
  {
   "scene": "sitting",
   "i": 14,
   "k": 0,
   "text": "阿哲還有另一個問題　他一整天都坐著",
   "start": 74.21,
   "end": 78.42,
   "syll": 16
  },
  {
   "scene": "sitting",
   "i": 15,
   "k": 1,
   "text": "國健署的調查裡　近五成國人每週身體活動不到 150 分鐘",
   "start": 78.74,
   "end": 85.58,
   "syll": 26
  },
  {
   "scene": "sitting",
   "i": 16,
   "k": 2,
   "text": "世界衛生組織說　騎腳踏車通勤也算運動",
   "start": 85.9,
   "end": 90.38,
   "syll": 17
  },
  {
   "scene": "idea",
   "i": 17,
   "k": 0,
   "text": "所以我們提出預測型友愛接力",
   "start": 91.88,
   "end": 95.3,
   "syll": 13
  },
  {
   "scene": "idea",
   "i": 18,
   "k": 1,
   "text": "模型每十分鐘算一次　哪一站四十分鐘內可能借空",
   "start": 95.62,
   "end": 101.14,
   "syll": 21
  },
  {
   "scene": "idea",
   "i": 19,
   "k": 2,
   "text": "就提前開放還車獎勵",
   "start": 101.46,
   "end": 103.83,
   "syll": 9
  },
  {
   "scene": "idea",
   "i": 20,
   "k": 3,
   "text": "而且不送現金　改送三十分鐘騎乘時數",
   "start": 104.15,
   "end": 108.36,
   "syll": 16
  },
  {
   "scene": "idea",
   "i": 21,
   "k": 4,
   "text": "時數只能拿來騎車　等於鼓勵大家多騎一段",
   "start": 108.68,
   "end": 113.42,
   "syll": 18
  },
  {
   "scene": "method",
   "i": 22,
   "k": 0,
   "text": "方法分三步　先記錄車數",
   "start": 115.02,
   "end": 117.65,
   "syll": 10
  },
  {
   "scene": "method",
   "i": 23,
   "k": 1,
   "text": "從車數的變化　估出每一站每十分鐘借和還的速度",
   "start": 117.97,
   "end": 123.5,
   "syll": 21
  },
  {
   "scene": "method",
   "i": 24,
   "k": 2,
   "text": "再往後推算借空的機率",
   "start": 123.82,
   "end": 126.45,
   "syll": 10
  },
  {
   "scene": "method",
   "i": 25,
   "k": 3,
   "text": "紐約的 Citi Bike　照各站將來缺多少車給點數",
   "start": 127.97,
   "end": 132.71,
   "syll": 18
  },
  {
   "scene": "method",
   "i": 26,
   "k": 4,
   "text": "巴黎的 Vélib' 曾送十五分鐘　給把車騎上坡的人",
   "start": 133.03,
   "end": 138.03,
   "syll": 19
  },
  {
   "scene": "method",
   "i": 27,
   "k": 5,
   "text": "我們把這兩個做法　用在中山的上下課",
   "start": 138.35,
   "end": 142.56,
   "syll": 16
  },
  {
   "scene": "demo",
   "i": 28,
   "k": 0,
   "text": "這是我們的網站",
   "start": 144.06,
   "end": 145.9,
   "syll": 7
  },
  {
   "scene": "demo",
   "i": 29,
   "k": 1,
   "text": "借車分頁告訴你去哪一站　最晚幾點出發",
   "start": 146.22,
   "end": 150.69,
   "syll": 17
  },
  {
   "scene": "demo",
   "i": 30,
   "k": 2,
   "text": "政策分頁算給學校和營運商看",
   "start": 151.01,
   "end": 154.43,
   "syll": 13
  },
  {
   "scene": "demo",
   "i": 31,
   "k": 3,
   "text": "十一月十一日下午四點半　現行規則一站都不付",
   "start": 154.75,
   "end": 160.02,
   "syll": 20
  },
  {
   "scene": "demo",
   "i": 32,
   "k": 4,
   "text": "提案會在海資館　體育館和材料大樓送三十分鐘",
   "start": 160.34,
   "end": 165.6,
   "syll": 20
  },
  {
   "scene": "demo",
   "i": 33,
   "k": 5,
   "text": "試算顯示　如果騎回校內的人多一半",
   "start": 165.92,
   "end": 169.87,
   "syll": 15
  },
  {
   "scene": "demo",
   "i": 34,
   "k": 6,
   "text": "傍晚借不到車少 11%　每天多 25 趟騎車",
   "start": 170.19,
   "end": 175.71,
   "syll": 21
  },
  {
   "scene": "demo",
   "i": 35,
   "k": 7,
   "text": "再加上下課前兩趟補車　少 27%",
   "start": 176.03,
   "end": 180.51,
   "syll": 17
  },
  {
   "scene": "results",
   "i": 36,
   "k": 0,
   "text": "我們用十二個沒有參與訓練的上課日檢驗",
   "start": 182.11,
   "end": 186.84,
   "syll": 18
  },
  {
   "scene": "results",
   "i": 37,
   "k": 1,
   "text": "91% 的借空　在發生前大約四十分鐘就被標出來",
   "start": 187.16,
   "end": 193.48,
   "syll": 24
  },
  {
   "scene": "results",
   "i": 38,
   "k": 2,
   "text": "我們寫了一頁建議書給學校　市府和營運商",
   "start": 193.8,
   "end": 198.54,
   "syll": 18
  },
  {
   "scene": "results",
   "i": 39,
   "k": 3,
   "text": "會有多少人因此提早還車還不知道　所以建議在校內試辦四週",
   "start": 198.86,
   "end": 205.7,
   "syll": 26
  },
  {
   "scene": "results",
   "i": 40,
   "k": 4,
   "text": "下次下課鐘響　阿哲走到圖資站　就有車可以騎",
   "start": 206.02,
   "end": 211.02,
   "syll": 19
  }
